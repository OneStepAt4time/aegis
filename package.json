{
  "name": "@onestepat4time/aegis",
  "version": "0.6.7",
  "type": "module",
  "description": "Orchestrate Claude Code sessions via API. Create, brief, monitor, refine, ship.",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js"
    },
    "./webhook": {
      "import": "./dist/webhook-signature.js",
      "types": "./dist/webhook-signature.d.ts"
    }
  },
  "bin": {
    "ag": "dist/cli.js",
    "aegis": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "templates",
    "!dist/__tests__",
    "!dist/**/*.map",
    "!scripts/docs-walkthrough/node_modules"
  ],
  "scripts": {
    "build": "tsc && npm run build:openapi && npm run build:dashboard && npm run build:copy-dashboard",
    "build:openapi": "node scripts/generate-openapi.mjs",
    "openapi:sync": "tsc && node scripts/generate-openapi.mjs --write-root",
    "openapi:check": "tsc && node scripts/generate-openapi.mjs --check-root",
    "build:copy-dashboard": "node scripts/copy-dashboard.mjs",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "hygiene-check": "node scripts/hygiene-check.cjs",
    "dashboard:tokens:gate": "node scripts/dashboard-tokens-gate.cjs",
    "dashboard:clickable:gate": "node scripts/clickable-gate.cjs",
    "dashboard:i18n:check": "node scripts/i18n-gate.cjs",
    "postinstall": "node scripts/postinstall-verify.cjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "docs": "typedoc",
    "gate": "npm run hygiene-check && npm run security-check && npm run dashboard:tokens:gate && npm run dashboard:clickable:gate && npx tsc --noEmit && npm run build && npm test",
    "start": "node dist/cli.js",
    "dev": "tsc && node dist/cli.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:smoke": "node scripts/uat-smoke.mjs",
    "test:smoke:byo-llm": "node scripts/byo-llm-smoke.mjs",
    "test:fault-harness": "vitest run src/__tests__/fault-injection-harness-901.test.ts",
    "sdk:ts:check": "npm --prefix packages/client ci && npm --prefix packages/client run generate:check",
    "sdk:py:generate": "node scripts/generate-python-sdk.mjs",
    "sdk:py:check": "node scripts/check-python-sdk.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src scripts",
    "security-check": "node scripts/check-no-shell-true.cjs",
    "dashboard:icons:audit": "node scripts/dashboard-icons-audit.cjs",
    "dashboard:a11y:check": "cd dashboard && npm run a11y:check",
    "test:e2e": "vitest run e2e/e2e-dogfood.test.ts",
    "test:e2e:ci": "vitest run e2e/e2e-dogfood.test.ts --reporter=verbose"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "orchestration",
    "coding-agent",
    "session-management"
  ],
  "author": "Emanuele Santonastaso (@OneStepAt4time)",
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.33.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation-fastify": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@types/nodemailer": "^8.0.0",
    "async-mutex": "^0.5.0",
    "fastify": "^5.8.5",
    "ip-address": "^10.2.0",
    "nodemailer": "^8.0.7",
    "openid-client": "^6.8.4",
    "prom-client": "^15.1.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "zod": "^4.4.3",
    "@anthropic-ai/sdk": "^0.91.1",
    "ip-address": "^10.2.0",
    "express-rate-limit": "^8.5.1",
    "hono": "^4.12.18",
    "fast-uri": "^3.1.2",
    "protobufjs": ">=8.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OneStepAt4time/aegis.git"
  },
  "homepage": "https://github.com/OneStepAt4time/aegis#readme",
  "bugs": {
    "url": "https://github.com/OneStepAt4time/aegis/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "lockfile-lint": "5.0.0",
    "prettier": "^3.8.1",
    "ts-morph": "^27.0.2",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "ioredis": "^5.10.1",
    "pg": "^8.20.0"
  }
}
